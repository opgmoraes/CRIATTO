# Copie este arquivo para .env.local e preencha com suas chaves.
# TODAS as chaves abaixo têm free tier. Você não precisa preencher todas —
# quanto mais preencher, mais forte fica o fallback (se um provedor falhar
# ou esgotar a cota, o próximo da lista entra automaticamente).

# 1) Groq (https://console.groq.com/keys) — grátis, MUITO rápido, ótimo para texto.
GROQ_API_KEY=

# 2) Google AI Studio / Gemini (https://aistudio.google.com/apikey) — grátis,
#    texto + visão (analisa imagens de referência). Recomendado ter essa.
GOOGLE_API_KEY=

# 3) OpenRouter (https://openrouter.ai/keys) — grátis, dá acesso a vários
#    modelos ":free" de diferentes empresas. Bom como 3ª opção de fallback.
OPENROUTER_API_KEY=

# Ordem de fallback para geração de TEXTO (copy). Separe por vírgula.
# Valores possíveis: groq, gemini, openrouter
AI_TEXT_PROVIDER_ORDER=groq,gemini,openrouter

# Ordem de fallback para ANÁLISE DE IMAGEM (referências visuais).
# Valores possíveis: gemini, groq
AI_VISION_PROVIDER_ORDER=gemini,groq

# ---- Imagens automáticas (opcional, todas gratuitas) ----
# Unsplash: https://unsplash.com/developers  | Pexels: https://www.pexels.com/api/  | Pixabay: https://pixabay.com/api/docs/
UNSPLASH_ACCESS_KEY=jlF25AqHgWwV3g7-re4J-6YIfYYxz2SDlJbXEmgA3PI
PEXELS_API_KEY=
PIXABAY_API_KEY=
